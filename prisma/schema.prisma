generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  role      String     @default("OPERATOR") // ADMIN, OPERATOR
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  blobs         Blob[]     @relation("UploadedBlobs")
  assignedBlobs Blob[]     @relation("AssignedBlobs")
  documents     Document[]

  @@map("users")
}


model Blob {
  id           String     @id @default(cuid())
  userId       String     // Link to the user who uploaded
  assignedToId String?    // Link to the operator currently working on it
  filename     String
  s3Path       String
  pageCount    Int        @default(0)
  status       String     @default("PENDING")
  batchNo      String?
  progress     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedAt   DateTime?
  completedAt  DateTime?
  user         User       @relation("UploadedBlobs", fields: [userId], references: [id])
  assignedTo   User?      @relation("AssignedBlobs", fields: [assignedToId], references: [id])
  auditLogs        AuditLog[]
  documents        Document[]
  pages            Page[]
  extractedValues  ExtractedValue[]

  @@map("blobs")
}


model Page {
  id              String         @id @default(cuid())
  blobId          String
  pageIndex       Int
  s3Path          String
  aiLabel         String?
  confidenceScore Float?
  isFlagged       Boolean        @default(false)
  rotation        Int            @default(0)
  anomalyFlags    String?        
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  documentPages   DocumentPage[]
  blob            Blob           @relation(fields: [blobId], references: [id], onDelete: Cascade)
  extractedValues ExtractedValue[]

  @@unique([blobId, pageIndex])
  @@map("pages")
}

model Document {
  id                 String         @id @default(cuid())
  userId             String
  blobId             String
  name               String
  documentType       String
  status             String         @default("AI_CLASSIFIED")
  checklists         Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id])
  auditLogs          AuditLog[]
  pages              DocumentPage[]
  blob               Blob           @relation(fields: [blobId], references: [id], onDelete: Cascade)
  checklistResults   DocumentChecklistResult[]

  @@map("documents")
}


model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageId     String
  order      Int
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageId])
  @@map("document_pages")
}


model AuditLog {
  id          String    @id @default(cuid())
  blobId      String
  documentId  String?
  action      String
  payload     String?
  performedBy String    @default("human")
  createdAt   DateTime  @default(now())
  document    Document? @relation(fields: [documentId], references: [id])
  blob        Blob      @relation(fields: [blobId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model ConfiguredDocType {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String?
  isCommon    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("configured_doc_types")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  results   DocumentChecklistResult[]

  @@map("checklist_items")
}

// Per-document results (answer/comment/flag) for each checklist question
model DocumentChecklistResult {
  id              String        @id @default(cuid())
  documentId      String
  checklistItemId String
  answer          String?
  comment         String?
  flagged         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([documentId, checklistItemId])
  @@map("document_checklist_results")
}

model StorageSettings {
  id          String   @id @default("default")
  provider    String   @default("SFTP") // SFTP or S3

  sftpHost    String?
  sftpPort    Int      @default(22)
  sftpUser    String?
  sftpPass    String?

  s3Bucket    String?
  s3Region    String?
  s3AccessKey String?
  s3SecretKey String?

  updatedAt   DateTime @updatedAt

  @@map("storage_settings")
}

model ClassificationCorrection {
  id                String   @id @default(cuid())
  blobId            String
  originalAiLabel   String
  finalHumanLabel   String
  pageThumbnailPath String
  createdAt         DateTime @default(now())

  @@map("classification_corrections")
}

model ExtractedValue {
  id              String   @id @default(cuid())
  blobId          String
  pageId          String
  documentName    String
  fieldName       String
  extractedValue  String
  qaValue         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blob Blob @relation(fields: [blobId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, fieldName])
  @@map("extracted_values")
}

